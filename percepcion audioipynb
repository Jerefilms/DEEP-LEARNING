        "\n",
        "import librosa\n",
        "import librosa.display\n",
        "import soundfile as sf\n",
        "import numpy as np\n",
        "import pandas as pd\n",
        "import matplotlib.pyplot as plt\n",
        "from google.colab import files\n",
        "\n",
        "print(\"ACA SUBIMOS LA CANCION QUE YO DAVID CELIS SUBIRE, QUE ES KAROLG:\")\n",
        "cargados = files.upload()\n",
        "\n",
        "\n",
        "audio_path = list(cargados.keys())[0]\n",
        "\n",
        "y, sr = librosa.load(audio_path, sr=22050)\n",
        "print(f\"\\n¡Audio cargado con éxito!\")\n",
        "print(f\"- Archivo: {audio_path}\")\n",
        "print(f\"- Frecuencia de muestreo (sr): {sr} Hz\")\n",
        "print(f\"- Total de muestras numéricas (longitud de y): {len(y)}\")\n",
        "\n",
        "hop_length = 512\n",
        "\n",
        "\n",
        "rms = librosa.feature.rms(y=y, hop_length=hop_length)[0]\n",
        "\n",
        "zcr = librosa.feature.zero_crossing_rate(y, hop_length=hop_length)[0]\n",
        "\n",
        "\n",
        "df_audio = pd.DataFrame({\n",
        "    'RMS_Energy': rms,\n",
        "    'Zero_Crossing_Rate': zcr\n",
        "})\n",
        "\n",
        "print(\"\\n--- Primeras 5 filas del DataFrame de Características ---\")\n",
        "print(df_audio.head())\n",
        "\n",
        "print(\"\\n--- Resumen Estadístico del Audio (df.describe()) ---\")\n",
        "print(df_audio.describe())\n",
        "\n",
        "plt.figure(figsize=(12, 8))\n",
        "\n",
        "\n",
        "plt.subplot(2, 1, 1)\n",
        "librosa.display.waveshow(y, sr=sr, alpha=0.6, color='b')\n",
        "plt.title(f'Forma de Onda de la Señal: {audio_path}')\n",
        "plt.xlabel('Tiempo (segundos)')\n",
        "plt.ylabel('Amplitud')\n",
        "plt.grid(True, linestyle='--', alpha=0.5)\n",
        "\n",
        "\n",
        "frames = range(len(rms))\n",
        "t_frames = librosa.frames_to_time(frames, sr=sr, hop_length=hop_length)\n",
        "\n",
        "plt.subplot(2, 1, 2)\n",
        "plt.plot(t_frames, rms, color='darkorange', label='Energía RMS', linewidth=1.5)\n",
        "plt.title('Evolución de la Energía RMS por Ventana de Tiempo')\n",
        "plt.xlabel('Tiempo (segundos)')\n",
        "plt.ylabel('Energía')\n",
        "plt.legend()\n",
        "plt.grid(True, linestyle='--', alpha=0.5)\n",
        "\n",
        "plt.tight_layout()\n",
        "plt.show()"
